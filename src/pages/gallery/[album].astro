---
import MainGridLayout from '@/layouts/MainGridLayout.astro';
import GalleryBrowser from '@/components/recovery/GalleryBrowser.svelte';
import {galleryConfig,siteConfig} from '@/config';
if(!siteConfig.pages.gallery)return Astro.redirect('/404/');
export function getStaticPaths(){const ids=new Set([...galleryConfig.albums.map(a=>a.id),'castorice-2026','test','wei-wei-an']);return [...ids].map(album=>({params:{album}}));}
const {album}=Astro.params;
---
<MainGridLayout title="相册详情" description="探索相册"><GalleryBrowser albumId={album} client:load /></MainGridLayout>
